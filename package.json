{
  "name": "git-ranch",
  "description": "🤠 Yeehaw! Wrangle yer GitHub Pull Requests like a true cowpoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "relay-compiler && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "relay": "relay-compiler",
    "server": "node server.js",
    "start": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "graphql": "^16.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-relay": "^20.1.1",
    "react-router-dom": "^7.1.3",
    "relay-runtime": "^20.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-relay": "^20.1.1",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "relay-compiler": "^20.1.1",
    "tailwindcss": "^4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
